<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateSBOM Condition="'$(Configuration)' == 'Release'">true</GenerateSBOM>
    <SbomGenerationNamespaceBaseUri>https://github.com/islamu-ngo/SecretKit/spdx</SbomGenerationNamespaceBaseUri>
    <SbomGenerationEnablePackageMetadataParsing>true</SbomGenerationEnablePackageMetadataParsing>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="All" />
  </ItemGroup>
</Project>
