# Copy to .env at the common clone root and restrict permissions: chmod 600 .env
# Never source this file in a shell. The provisioner parses literal KEY=value.
# Never store human passwords or bearer tokens here. All values below are synthetic.
# Select local or remote explicitly; only that mode's variables are loaded.
INFISICAL_MODE=local

# Local disposable Podman sandbox: eng/live-infisical/sandbox.sh up
# bootstrap-local writes organization and Universal Auth credentials here.
INFISICAL_LOCAL_ORIGIN=http://127.0.0.1:18080
INFISICAL_LOCAL_OWNER=secretkit-sdk-01234567
INFISICAL_LOCAL_ORGANIZATION_ID=replace-with-local-organization-id
INFISICAL_LOCAL_AUTOMATION_CLIENT_ID=replace-with-local-machine-client-id
INFISICAL_LOCAL_AUTOMATION_CLIENT_SECRET=replace-with-local-machine-client-secret
# Fixture enrollment IDs are checkpointed after confirmed creation.
# Existing same-name resources require explicit operator enrollment by ID.
# Do not reuse enrollment IDs after changing origin or organization.
# Both enrollment scope fields are required whenever any ID is enrolled.
# INFISICAL_LOCAL_ENROLLMENT_ORIGIN=http://127.0.0.1:18080/
# INFISICAL_LOCAL_ENROLLMENT_ORGANIZATION_ID=replace-with-local-organization-id
# INFISICAL_LOCAL_PROJECT_A_ID=replace-with-project-a-id
# INFISICAL_LOCAL_PROJECT_B_ID=replace-with-project-b-id
# INFISICAL_LOCAL_IMPORT_PROJECT_ID=replace-with-import-project-id
# INFISICAL_LOCAL_SETUP_IDENTITY_ID=replace-with-setup-identity-id
# INFISICAL_LOCAL_RUNTIME_IDENTITY_ID=replace-with-runtime-identity-id
# INFISICAL_LOCAL_DENIED_IDENTITY_ID=replace-with-denied-identity-id
# INFISICAL_LOCAL_ADMINISTRATIVE_IDENTITY_ID=replace-with-administrative-identity-id
# INFISICAL_LOCAL_OBSERVER_IDENTITY_ID=replace-with-observer-identity-id

# Remote mode requires HTTPS and explicit authority for live mutations.
INFISICAL_REMOTE_ORIGIN=https://infisical.example.invalid
INFISICAL_REMOTE_ORGANIZATION_ID=replace-with-remote-organization-id
INFISICAL_REMOTE_AUTOMATION_CLIENT_ID=replace-with-remote-machine-client-id
INFISICAL_REMOTE_AUTOMATION_CLIENT_SECRET=replace-with-remote-machine-client-secret
# INFISICAL_REMOTE_ENROLLMENT_ORIGIN=https://infisical.example.invalid/
# INFISICAL_REMOTE_ENROLLMENT_ORGANIZATION_ID=replace-with-remote-organization-id
# INFISICAL_REMOTE_PROJECT_A_ID=replace-with-project-a-id
# INFISICAL_REMOTE_PROJECT_B_ID=replace-with-project-b-id
# INFISICAL_REMOTE_IMPORT_PROJECT_ID=replace-with-import-project-id
# INFISICAL_REMOTE_SETUP_IDENTITY_ID=replace-with-setup-identity-id
# INFISICAL_REMOTE_RUNTIME_IDENTITY_ID=replace-with-runtime-identity-id
# INFISICAL_REMOTE_DENIED_IDENTITY_ID=replace-with-denied-identity-id
# INFISICAL_REMOTE_ADMINISTRATIVE_IDENTITY_ID=replace-with-administrative-identity-id
# INFISICAL_REMOTE_OBSERVER_IDENTITY_ID=replace-with-observer-identity-id
