{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current SecretKit provider admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "provider", "policy", "sources", "operations", "exclusions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "current-admission" },
    "provider": { "enum": ["Infisical", "AzureKeyVault"] },
    "policy": { "const": "complete-live" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256"],
        "properties": {
          "file": { "type": "string", "pattern": "^src/SecretKit\\.(Infisical|AzureKeyVault)(\\.Management)?/[A-Za-z0-9]+\\.cs$", "maxLength": 512 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "member", "variants", "contract", "effect", "requiredCases", "prerequisites"],
        "properties": {
          "id": { "$ref": "#/$defs/label" },
          "member": { "$ref": "#/$defs/text" },
          "variants": { "$ref": "#/$defs/variants" },
          "contract": { "enum": ["implemented-subset", "contract-gap"] },
          "effect": { "$ref": "#/$defs/text" },
          "requiredCases": { "$ref": "#/$defs/labels" },
          "prerequisites": { "$ref": "#/$defs/labels" }
        }
      }
    },
    "exclusions": { "$ref": "#/$defs/texts" }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[ -~]+$" },
    "labels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/label" } },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!native$)[A-Za-z0-9_.-]+$" }
    },
    "texts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  }
}
