<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="EnterpriseHardeningWorkflow.cs" />
    <Compile Include="InstalledInfisical.cs" />
    <Compile Include="NativeProgram.cs" />
    <Compile Include="../NativeCaseContract.cs" Link="Native/NativeCaseContract.cs" />
    <Compile Include="../NativeRunContract.cs" Link="Native/NativeRunContract.cs" />
    <Compile Include="../../SecretKit.Infisical.Conformance.Tests/Infrastructure/NativeEnvironment.cs" Link="Native/NativeEnvironment.cs" />
    <Compile Include="../../SecretKit.Infisical.Conformance.Tests/Infrastructure/OwnedProcess.cs" Link="Native/OwnedProcess.cs" />
    <Compile Include="../../SecretKit.AzureKeyVault.Conformance.Tests/Infrastructure/OwnedAzureEnvironment.cs" Link="Native/OwnedAzureEnvironment.cs" />
    <Compile Include="../../SecretKit.Infisical.Conformance.Tests/Admission/**/*.cs" Link="Native/Infisical/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../SecretKit.AzureKeyVault.Conformance.Tests/Admission/**/*.cs" Link="Native/Azure/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="SecretKit.Core" Version="$(SecretKitCandidateVersion)" />
    <PackageReference Include="SecretKit.Infisical" Version="$(SecretKitCandidateVersion)" />
    <PackageReference Include="SecretKit.AzureKeyVault" Version="$(SecretKitCandidateVersion)" />
    <PackageReference Include="SecretKit.Extensions.Configuration" Version="$(SecretKitCandidateVersion)" />
    <PackageReference Include="SecretKit.Extensions.Hosting" Version="$(SecretKitCandidateVersion)" />
    <PackageReference Include="SecretKit.Infisical.Management" Version="$(SecretKitCandidateVersion)" />
    <PackageReference Include="SecretKit.AzureKeyVault.Management" Version="$(SecretKitCandidateVersion)" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <Compile Include="../../../samples/RuntimeConfiguration/BootstrapScenario.cs" Link="Consumers/BootstrapScenario.cs" />
    <Compile Include="../../../samples/RuntimeConfiguration/IRuntimeIntegrationClient.cs" Link="Consumers/IRuntimeIntegrationClient.cs" />
    <Compile Include="../../../samples/ProviderAssessment/AssessmentScenario.cs" Link="Consumers/AssessmentScenario.cs" />
  </ItemGroup>
  <Target Name="RequireCandidateVersion" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(SecretKitCandidateVersion)' == ''" Text="SecretKitCandidateVersion is required." />
  </Target>
</Project>
