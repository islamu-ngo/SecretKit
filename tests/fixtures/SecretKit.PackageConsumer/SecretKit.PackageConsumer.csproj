<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <PackageReference Include="SecretKit.Core" Version="0.1.0-preview.1" />
    <PackageReference Include="SecretKit.Infisical" Version="0.1.0-preview.1" />
    <PackageReference Include="SecretKit.AzureKeyVault" Version="0.1.0-preview.1" />
    <PackageReference Include="SecretKit.Extensions.Configuration" Version="0.1.0-preview.1" />
    <PackageReference Include="SecretKit.Extensions.Hosting" Version="0.1.0-preview.1" />
    <PackageReference Include="SecretKit.Infisical.Management" Version="0.1.0-preview.1" />
    <PackageReference Include="SecretKit.AzureKeyVault.Management" Version="0.1.0-preview.1" />
    <Compile Include="../../../samples/RuntimeConfiguration/BootstrapScenario.cs" Link="Consumers/BootstrapScenario.cs" />
    <Compile Include="../../../samples/ProviderAssessment/AssessmentScenario.cs" Link="Consumers/AssessmentScenario.cs" />
  </ItemGroup>
</Project>
