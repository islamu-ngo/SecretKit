<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <LocalConsumerMode Condition="'$(LocalConsumerMode)' == ''">minimal</LocalConsumerMode>
    <DefineConstants Condition="'$(LocalConsumerMode)' == 'configuration' Or '$(LocalConsumerMode)' == 'full'">$(DefineConstants);CONFIGURATION</DefineConstants>
    <DefineConstants Condition="'$(LocalConsumerMode)' == 'hosting' Or '$(LocalConsumerMode)' == 'full'">$(DefineConstants);HOSTING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="RuntimeHardeningWorkflow.cs" />
    <Compile Include="NativeWorkflow.cs" />
    <Compile Include="NativeLifetimeTrials.cs" />
    <PackageReference Include="SecretKit.Core" Version="[$(SecretKitCandidateVersion)]" />
    <PackageReference Include="SecretKit.Infisical" Version="[$(SecretKitCandidateVersion)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(LocalConsumerMode)' == 'configuration' Or '$(LocalConsumerMode)' == 'full'">
    <PackageReference Include="SecretKit.Extensions.Configuration" Version="[$(SecretKitCandidateVersion)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(LocalConsumerMode)' == 'hosting' Or '$(LocalConsumerMode)' == 'full'">
    <PackageReference Include="SecretKit.Extensions.Hosting" Version="[$(SecretKitCandidateVersion)]" />
  </ItemGroup>
  <Target Name="RequireLocalCandidate" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(SecretKitCandidateVersion)' == ''" Text="SecretKitCandidateVersion is required." />
    <Error Condition="'$(LocalConsumerMode)' != 'minimal' And '$(LocalConsumerMode)' != 'configuration' And '$(LocalConsumerMode)' != 'hosting' And '$(LocalConsumerMode)' != 'full'" Text="Unknown local consumer mode." />
  </Target>
</Project>
